---
/**
 * Writing route template.
 *
 * To enable the writing section:
 *   1. Copy this file to `src/pages/writing/[slug].astro`.
 *   2. Drop MDX files in `src/content/writing/` matching the schema
 *      in `src/content/config.ts` (title, description, publishedAt,
 *      updatedAt?, draft).
 *   3. Uncomment + expand the writing <section> marker in
 *      `src/pages/index.astro` to list entries (see bottom of this
 *      file for an example loop to paste into index.astro).
 *
 * This template ships a minimal post layout: h1 + publishedAt + MDX
 * body rendered into the Base layout. No tags, no prev/next — add
 * them later if/when you have more than ~5 posts.
 */

import { type CollectionEntry, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"writing">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const publishedLabel = entry.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<Base title={entry.data.title} description={entry.data.description}>
  <main>
    <p><a href="/">← David Frost</a></p>

    <h1>{entry.data.title}</h1>
    <p style="color: var(--color-muted);">
      <time datetime={entry.data.publishedAt.toISOString()}>{publishedLabel}</time>
    </p>

    <Content />
  </main>
</Base>

{/*
  Example loop to paste into src/pages/index.astro in place of the
  {/* Writing section goes here */} marker:

  ---
  import { getCollection } from "astro:content";
  const posts = (await getCollection("writing", ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
  ---

  <h2>Writing</h2>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.slug}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
*/}
