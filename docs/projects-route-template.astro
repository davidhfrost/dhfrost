---
/**
 * Projects route template.
 *
 * To enable the projects section:
 *   1. Copy this file to `src/pages/projects/[slug].astro`.
 *   2. Drop MDX files in `src/content/projects/` matching the schema
 *      in `src/content/config.ts` (title, description, url?, repo?,
 *      year, featured).
 *   3. Uncomment + expand the projects <section> marker in
 *      `src/pages/index.astro` to list entries (see bottom of this
 *      file for an example loop to paste into index.astro).
 *
 * This template ships a minimal project detail layout: h1 + year +
 * external links + MDX body rendered into the Base layout.
 */

import { type CollectionEntry, getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("projects");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Base title={entry.data.title} description={entry.data.description}>
  <main>
    <p><a href="/">← David Frost</a></p>

    <h1>{entry.data.title}</h1>
    <p style="color: var(--color-muted);">{entry.data.year}</p>

    <p>
      {entry.data.url && <a href={entry.data.url}>Live</a>}
      {entry.data.url && entry.data.repo && " · "}
      {entry.data.repo && <a href={entry.data.repo}>Source</a>}
    </p>

    <Content />
  </main>
</Base>

{/*
  Example loop to paste into src/pages/index.astro in place of the
  {/* Projects section goes here */} marker:

  ---
  import { getCollection } from "astro:content";
  const projects = (await getCollection("projects"))
    .sort((a, b) => b.data.year - a.data.year);
  ---

  <h2>Projects</h2>
  <ul>
    {projects.map((project) => (
      <li>
        <a href={`/projects/${project.slug}`}>{project.data.title}</a>
        {" — "}
        <span style="color: var(--color-muted);">{project.data.description}</span>
      </li>
    ))}
  </ul>
*/}
