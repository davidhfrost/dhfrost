---
import Meta, { type ArticleMeta } from "../components/Meta.astro";
import { profile } from "../data/profile";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  homepageSchema?: boolean;
  article?: ArticleMeta;
}

const { title, description, image, imageAlt, homepageSchema, article } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Meta title={title} description={description} image={image} imageAlt={imageAlt} homepageSchema={homepageSchema} article={article} />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="page">
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer>
        <a href="/about/">About</a>
        {" · "}
        <a href={profile.social.github}>GitHub</a>
        {" · "}
        <a href={profile.social.linkedin}>LinkedIn</a>
        {" · "}
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
