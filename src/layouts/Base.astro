---
import Meta from "../components/Meta.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  personSchema?: boolean;
}

const { title, description, personSchema } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Meta title={title} description={description} personSchema={personSchema} />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="page">
      <slot />
      <footer>
        <a href="https://github.com/davidhfrost">GitHub</a>
        {" · "}
        <a href="https://www.linkedin.com/in/davidhfrost">LinkedIn</a>
        {" · "}
        <a href="/rss.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
