---
import { getCollection } from "astro:content";
import { profile } from "../data/profile";
import Base from "../layouts/Base.astro";

const title = `${profile.name} · ${profile.jobTitle} at ${profile.employer.name}`;
const description =
  "David Frost is a software engineer at Capital One. Writing on software engineering, with a focus on cloud infrastructure, infrastructure as code, and CI/CD. Side project: Retrofolio, a portfolio backtester.";
const tagline = profile.tagline;

const recentPosts = (
  await getCollection("writing", ({ data }) => (import.meta.env.PROD ? !data.draft : true))
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

// Collection-backed projects (those with a homepage `cardSummary`), newest
// first. Smart Lamp and dhfrost.com are not collection entries, so they
// stay as inline prose below.
const cardProjects = (await getCollection("projects"))
  .filter((project) => project.data.cardSummary)
  .sort((a, b) => b.data.year - a.data.year);
---
<Base title={title} description={description} homepageSchema={true}>
  <h1>David Frost</h1>
    <p>{tagline}</p>

    <h2>Now</h2>
    <p>
      I'm building Retrofolio, a portfolio backtester born out of an interest in portfolio theory and historical asset allocation. At Capital One I work on the network infrastructure behind the web and mobile apps, mostly cloud engineering, infrastructure-as-code, and CI/CD.
    </p>

    <h2>Writing</h2>

    {recentPosts.length > 0 ? (
      <>
        {recentPosts.map((post) => (
          <p>
            <a href={`/writing/${post.id}`}>{post.data.title}</a>
            {" · "}
            <time datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toLocaleDateString("en-US", {
                timeZone: "UTC",
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </p>
        ))}
      </>
    ) : (
      <p>No posts yet.</p>
    )}

    <h2>Projects</h2>

    {cardProjects.map((project) => (
      <p>
        <a href={`/projects/${project.id}`}>{project.data.title}</a>: {project.data.cardSummary}
      </p>
    ))}

    <p>
      Smart Lamp: IoT lighting system built with Raspberry Pi, MQTT, and Bluetooth for real-time control. Backed by a Django web dashboard with WebSockets and a native iOS app in Swift, with Ansible handling provisioning. Built four full-stack interfaces around a single physical device.
    </p>

    <p>
      dhfrost.com: yes, this one. Astro and Tailwind on Cloudflare Pages, with the surrounding Cloudflare config codified in OpenTofu. Site and infra both ship through CI/CD: preview on PR, deploy on merge.
    </p>
</Base>
