---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = await getCollection("writing", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);

posts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<Base
  title="Writing · David Frost"
  description="Essays and notes by David Frost on software engineering, infrastructure, and adjacent topics."
>
  <main>
    <h1>Writing</h1>
    {posts.map((post) => (
      <div class="post-entry">
        <a href={`/writing/${post.id}`}>{post.data.title}</a>
        <p>{post.data.description}</p>
        <time class="post-entry-date" datetime={post.data.publishedAt.toISOString()}>
          {post.data.publishedAt.toLocaleDateString("en-US", {
            timeZone: "UTC",
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
      </div>
    ))}
  </main>
</Base>
