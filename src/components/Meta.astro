---
/**
 * Page-level <head> metadata: title, description, canonical, OG, Twitter.
 * Used by Base.astro on every page. Keep dumb — no DOM effects, no JS.
 *
 * Pass homepageSchema={true} only on the homepage. It emits two JSON-LD
 * blocks: Person (entity hub for David Frost) and WebSite (whose `name`
 * Google uses as the SERP "site name" instead of the bare host).
 */
interface Props {
  title: string;
  description: string;
  image?: string;
  homepageSchema?: boolean;
}

const { title, description, image = "/og.png", homepageSchema = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();

const siteOrigin = (Astro.site ?? Astro.url).toString().replace(/\/$/, "");

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "David Frost",
  alternateName: "davidhfrost",
  url: `${siteOrigin}/`,
  image: `${siteOrigin}/og.png`,
  jobTitle: "Software Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Capital One",
    url: "https://www.capitalone.com",
  },
  sameAs: ["https://github.com/davidhfrost", "https://www.linkedin.com/in/davidhfrost"],
  description: "Software engineer working on cloud infrastructure at Capital One.",
  knowsAbout: ["Cloud infrastructure", "Infrastructure as code", "CI/CD", "Distributed systems"],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "David Frost",
  alternateName: "dhfrost.com",
  url: `${siteOrigin}/`,
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
<meta name="author" content="David Frost" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="David Frost" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="alternate" type="application/rss+xml" title="David Frost" href="/rss.xml" />

{homepageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
)}
{homepageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
)}
