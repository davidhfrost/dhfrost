---
/**
 * Page-level <head> metadata: title, description, canonical, OG, Twitter.
 * Used by Base.astro on every page. Keep dumb — no DOM effects, no JS.
 *
 * Pass homepageSchema={true} only on the homepage. It emits two JSON-LD
 * blocks: Person (entity hub for David Frost) and WebSite (whose `name`
 * Google uses as the SERP "site name" instead of the bare host).
 *
 * Pass `article` on writing posts. It flips og:type to "article", emits
 * article:published_time / article:modified_time, and a BlogPosting JSON-LD
 * block whose author points back at the Person entity hub.
 */
import { profile } from "../data/profile";

export interface ArticleMeta {
  /** Bare post title, without the " · David Frost" site suffix. */
  title: string;
  publishedAt: Date;
  updatedAt?: Date;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  homepageSchema?: boolean;
  article?: ArticleMeta;
}

const { title, description, image = "/og.png", homepageSchema = false, article } = Astro.props;

const ogType = article ? "article" : "website";

// Astro.site is set in astro.config.mjs. If it's ever missing, fail loudly
// rather than silently emitting request-host URLs as canonicals.
const canonical = new URL(Astro.url.pathname, Astro.site!).toString();
const ogImage = new URL(image, Astro.site!).toString();

const siteOrigin = Astro.site!.toString().replace(/\/$/, "");

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.alternateName,
  url: `${siteOrigin}/`,
  image: `${siteOrigin}/og.png`,
  jobTitle: profile.jobTitle,
  worksFor: {
    "@type": "Organization",
    name: profile.employer.name,
    url: profile.employer.url,
  },
  sameAs: [profile.social.github, profile.social.linkedin],
  description: profile.tagline,
  knowsAbout: profile.knowsAbout,
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: profile.name,
  alternateName: profile.alternateName,
  url: `${siteOrigin}/`,
};

const articleJsonLd = article && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: ogImage,
  datePublished: article.publishedAt.toISOString(),
  ...(article.updatedAt ? { dateModified: article.updatedAt.toISOString() } : {}),
  author: {
    "@type": "Person",
    name: profile.name,
    url: `${siteOrigin}/`,
  },
};

// Escape `<`, `>`, `&` so a stray `</script>` or `<!--` in a future schema
// value can't break out of the surrounding <script> tag. Also escape
// U+2028 and U+2029, which are valid in JSON but terminate JS string
// literals in some interpreters. JSON-LD parsers decode the \uXXXX
// escapes back to the original characters.
const jsonLd = (obj: unknown) =>
  JSON.stringify(obj)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
<meta name="author" content="David Frost" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="David Frost" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{article && (
  <meta property="article:published_time" content={article.publishedAt.toISOString()} />
)}
{article?.updatedAt && (
  <meta property="article:modified_time" content={article.updatedAt.toISOString()} />
)}
{article && <meta property="article:author" content={profile.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="alternate" type="application/rss+xml" title="David Frost" href="/rss.xml" />

{homepageSchema && (
  <script type="application/ld+json" set:html={jsonLd(personJsonLd)} />
)}
{homepageSchema && (
  <script type="application/ld+json" set:html={jsonLd(websiteJsonLd)} />
)}
{articleJsonLd && (
  <script type="application/ld+json" set:html={jsonLd(articleJsonLd)} />
)}
